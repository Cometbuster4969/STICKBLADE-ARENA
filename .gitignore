# ======================================================================
# STICKBLADE ARENA — .gitignore
# Protects: secrets, local databases, user data, build artifacts, caches
# ======================================================================

# ---------------- SECRETS — never commit these ----------------
# (stickblade-web/.env.example is deliberately tracked: it documents the
#  one public variable the frontend needs. The negation lives in
#  stickblade-web/.gitignore so this rule stays simple.)
.env
.env.*
*.env
.envrc
secrets.*
*.key
*.pem
credentials*.json
service-account*.json
.netrc
.git-credentials
.aws/
.ssh/

# ---------------- Local data / generated match output ----------------
# Arena runtime data (SQLite DB + stored replays + turn logs) is created
# wherever the backend runs — never commit it.
arena_data/
*.db
*.sqlite
*.sqlite3
replays/
battle_log_*.json
log_*.json
shot_*.png
design_*.png
joint_shot*.png
wp_*.png
fl_*.png
*.pid
*.mp4

# ---------------- Python ----------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
wheels/
.venv/
venv/
env/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

# ---------------- Node / Next.js (stickblade-web) ----------------
node_modules/
.next/
out/
.turbo/
.swc/
*.tsbuildinfo
.vercel
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------------- OS / editor noise ----------------
.DS_Store
.DS_Store?
._*
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-*

# ---------------- Misc caches / scratch ----------------
.cache/
.npm/
nohup.out
*.log
*.tmp
tmp/
temp/

# ---------------- Research exports (generated, large) ----------------
# research/ itself is tracked (published datasets + reports); only the
# bulk export output of tools/export_dataset.py stays local.
/research/exports/
